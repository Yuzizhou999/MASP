{
  // 配置格式版本。
  "schemaVersion": 1,

  // 可用于等待、让路或倒退恢复的安全节点。
  // allowedRobotGroups 表示哪些车型可以使用该节点。
  "recoveryNodes": [
    {"nodeId": "fork:PP1171", "allowedRobotGroups": ["fork"]},
    {"nodeId": "fork:PP1172", "allowedRobotGroups": ["fork"]},
    {"nodeId": "fork:PP1173", "allowedRobotGroups": ["fork"]},
    {"nodeId": "fork:PP1174", "allowedRobotGroups": ["fork"]},
    {"nodeId": "fork:PP1175", "allowedRobotGroups": ["fork"]},
    {"nodeId": "fork:CP1039", "allowedRobotGroups": ["fork"]},
    {"nodeId": "fork:CP1153", "allowedRobotGroups": ["fork"]},
    {"nodeId": "jack:PP363", "allowedRobotGroups": ["jack"]},
    {"nodeId": "jack:PP365", "allowedRobotGroups": ["jack"]},
    {"nodeId": "jack:PP367", "allowedRobotGroups": ["jack"]},
    {"nodeId": "jack:PP399", "allowedRobotGroups": ["jack"]},
    {"nodeId": "jack:PP695", "allowedRobotGroups": ["jack"]},
    {"nodeId": "jack:PP696", "allowedRobotGroups": ["jack"]},
    {"nodeId": "jack:CP49", "allowedRobotGroups": ["jack"]},
    {"nodeId": "jack:CP50", "allowedRobotGroups": ["jack"]}
  ],

  // 阶段 0 暂不划分窄路区，因此当前为空；阶段 4 会根据地图补充。
  "zones": [
    // 单个区域的格式如下。示例中的 ID 必须替换为地图中的真实 ID 后才能启用：
    // {
    //   "id": "zone-narrow-001",                  // 区域唯一编号。
    //   "memberNodeIds": ["fork:LM..."],          // 区域内部节点。
    //   "memberEdgeIds": ["fork:edge-..."],       // 区域内部道路。
    //   "entryEdgeIds": ["fork:edge-..."],        // 进入区域的道路。
    //   "exitEdgeIds": ["fork:edge-..."],         // 离开区域的道路。
    //   "capacity": 1,                             // 区域最多同时容纳的车辆数。
    //   "passingAllowed": false,                   // 区域内是否允许会车。
    //   "directionalMode": "single_direction_at_a_time",
    //   "recoveryNodeIds": ["fork:PP1171"]        // 堵塞时可退出到的恢复点。
    // }
  ]
}
