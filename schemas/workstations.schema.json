{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masp.local/schemas/workstations.schema.json",
  "title": "MASP workstation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "map", "workstations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "map": {"type": "string", "minLength": 1},
    "workstations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nodeId",
          "capabilities",
          "allowedRobotGroups",
          "capacity",
          "pickupServiceMs",
          "dropoffServiceMs",
          "blocksTransitDuringService",
          "propertiesByGroup"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "nodeId": {"type": "string", "minLength": 1},
          "capabilities": {
            "type": "array",
            "items": {"enum": ["pickup", "dropoff"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "allowedRobotGroups": {
            "type": "array",
            "items": {"enum": ["fork", "jack"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "capacity": {"type": "integer", "minimum": 1},
          "pickupServiceMs": {"type": "integer", "minimum": 1},
          "dropoffServiceMs": {"type": "integer", "minimum": 1},
          "blocksTransitDuringService": {"type": "boolean"},
          "propertiesByGroup": {"type": "object"}
        }
      }
    }
  }
}

