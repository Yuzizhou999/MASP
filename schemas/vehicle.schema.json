{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masp.local/schemas/vehicle.schema.json",
  "title": "MASP initial vehicle configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixedDuringRun", "vehicles"],
  "properties": {
    "schemaVersion": {"const": 1},
    "fixedDuringRun": {"const": true},
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vehicleId",
          "robotGroup",
          "initialNodeId",
          "initialHeadingRad",
          "initialLoadState"
        ],
        "properties": {
          "vehicleId": {"type": "string", "minLength": 1, "maxLength": 128},
          "robotGroup": {"enum": ["fork", "jack"]},
          "initialNodeId": {"type": "string", "minLength": 1},
          "initialHeadingRad": {
            "type": "number",
            "minimum": -6.283186,
            "maximum": 6.283186
          },
          "initialLoadState": {"enum": ["empty", "loaded"]},
          "payloadId": {"type": ["string", "null"]},
          "capabilities": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true,
            "default": []
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"initialLoadState": {"const": "loaded"}},
              "required": ["initialLoadState"]
            },
            "then": {"required": ["payloadId"]}
          }
        ]
      }
    }
  }
}
